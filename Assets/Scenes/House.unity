--- !u!114 &933004353
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 933004352}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5faf029865a958844ba74b5ecd587038, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageInteractable
  pageNumber: 4
  pageTitle: Diary Entry - December 1
  diaryEntry: 'I found her.



    The little room behind the old wall.



    Her
    crib. Her blanket. Her favorite doll.



    I remember now.



    She was hiding
    here when the fire started.



    I searched everywhere, but I never found her.



    My
    little Lily was here all along.



    She was waiting for me.



    I have
    been singing to an empty room.



    I am so sorry, my little Lily.



    Mommy
    is here now.



    Sleep, my little angel.



    Sleep.'
  readOnce: 0
