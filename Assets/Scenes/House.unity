--- !u!114 &1401858154
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1401858149}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5faf029865a958844ba74b5ecd587038, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageInteractable
  pageNumber: 2
  pageTitle: Diary Entry - October 3
  diaryEntry: 'The rain was heavy last night.



    I left Lily in her crib while
    I went downstairs to prepare her milk.



    Then, I smelled smoke.



    The
    fire spread so quickly. I ran upstairs, calling her name, but the smoke was too
    thick.



    I could not find her.



    I searched every room, but my baby
    was gone.



    Please, God.



    Please bring my little girl back to me.'
  readOnce: 0
