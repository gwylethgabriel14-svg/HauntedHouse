--- !u!114 &1511626950
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1511626945}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5faf029865a958844ba74b5ecd587038, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageInteractable
  pageNumber: 1
  pageTitle: Diary Entry - June 12
  diaryEntry: 'My little Lily is finally asleep.



    She is only a few months
    old, but she already recognizes my voice. Whenever she cries, I sing her favorite
    lullaby, and she slowly closes her little eyes.



    Sometimes, I wonder what
    her first words will be.



    I hope she calls me Mommy.



    I love her
    more than anything in this world.



    I will protect her. Always.'
  readOnce: 0
