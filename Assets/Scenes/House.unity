--- !u!114 &1375435468
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1375435463}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5faf029865a958844ba74b5ecd587038, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryPageInteractable
  pageNumber: 3
  pageTitle: Diary Entry - November 19
  diaryEntry: 'I hear her crying.



    Every night, I hear the soft cries of a
    baby somewhere inside the house.



    I follow the sound, but it always disappears.



    I
    know it is Lily.



    She must be cold. She must be scared.



    I sing her
    lullaby, hoping she will hear me.



    I will find her.



    No one will
    take my baby away from me.



    No one.'
  readOnce: 0
